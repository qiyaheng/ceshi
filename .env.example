﻿﻿﻿﻿# ===== 本服务对外鉴权 =====
# 第三方调用你的 API 时需要携带的 Key；留空表示不鉴权（仅限本地调试）
SERVICE_API_KEY=

# ===== 主力渠道：火山方舟（Agent Plan 或方舟 API Key 均可）=====
# 控制台: https://console.volcengine.com/ark  开通后在 API Key 管理页创建
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可填模型名（如 doubao-seed-2.0-mini / deepseek-v4-flash）或推理接入点 ep-xxxx
ARK_MODEL=doubao-seed-2.0-mini

# ===== 备份渠道：DeepSeek 官方 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 兜底渠道：自定义模型（任何 OpenAI 兼容端点，像 TraeCode 添加模型一样填地址即可）=====
# 项目内置本地模型：先运行 scripts\download_model.ps1 下载 GGUF，再运行 scripts\start_local_model.ps1
# 也可接外部服务：Ollama 填 http://localhost:11434/v1，LM Studio 填 http://localhost:1234/v1
# 模型 id 由启动脚本 --model_alias 固定为 qwen3-4b
# 为防止本机代理劫持请求，统一使用 localhost（代码内已内置 NO_PROXY 直连回环地址）
# 模型 id 由启动脚本的 --model_alias 指定（qwen3-4b），避免路径斜杠在 JSON 转义中被破坏
CUSTOM_MODEL=qwen3-4b
CUSTOM_BASE_URL=http://localhost:8081/v1
CUSTOM_API_KEY=none

# 请求超时（秒）：本地 CPU 小模型建议 >= 300
LLM_TIMEOUT=300
